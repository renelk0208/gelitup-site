VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Master switch — must be true for /portal/login, /portal/admin-login and all /portal/dashboard/* routes to work
VITE_ENABLE_PORTAL=true
VITE_PRODUCTS_URL=
VITE_SOLID_COLOURS_URL=
VITE_B2B_PRODUCTS_TABLE=b2b_products
VITE_B2B_ORDERS_TABLE=b2b_orders
VITE_B2B_REGISTRATIONS_TABLE=b2b_registrations
VITE_B2B_ADMINS_TABLE=b2b_admins
VITE_REQUIRE_B2B_APPROVAL=true
VITE_EMAIL_WEBHOOK_URL=
VITE_EMAIL_FROM=distributors@gelitup.com
VITE_EMAIL_REPLY_TO=distribution@gelitup.com
VITE_B2B_ORDER_INBOX=distribution@gelitup.com
VITE_PROFORMA_COMPANY_NAME=GEL.IT.UP Factory Direct
VITE_PROFORMA_VAT_TAX_ID=VAT/TAX ID: BG202102027
VITE_PROFORMA_BANK_DETAILS=BANK: Postbank Bulgaria | IBAN: BG53BPBI79401072289901
VITE_PROFORMA_SWIFT_BIC=
VITE_PROFORMA_LEFT_LOGO=/NEW LOGO 2024-03.png
VITE_PROFORMA_RIGHT_LOGO=/logo.png
VITE_PROFORMA_LEEUKOPF_COMPANY=Leeukopf
VITE_PROFORMA_LEEUKOPF_ADDRESS=8 Racho Dimchev, Sofia, Bulgaria
VITE_PROFORMA_LEEUKOPF_PHONE=(+359) 73 891 041
VITE_PROFORMA_LEEUKOPF_EMAIL=info@leeukopf.com
VITE_PORTAL_FONT_TTF_URL=/fonts/PFFUTURANEU-BOOK.ttf
VITE_ENABLE_ZOHO_SYNC=false
# Supabase Edge Function URL (recommended):
# https://<project-ref>.functions.supabase.co/zoho-sync-order
VITE_ZOHO_SYNC_WEBHOOK_URL=
# Optional: set to same value as ZOHO_SYNC_SHARED_SECRET function secret
VITE_ZOHO_SYNC_AUTH_TOKEN=
VITE_ZOHO_SYNC_TARGET=books
VITE_ZOHO_SYNC_TIMEOUT_MS=12000

# Payment methods shown to clients when an invoice is ready
# Bank details string displayed verbatim (line breaks supported)
VITE_PAYMENT_BANK_DETAILS=
# Optional online payment links (leave blank to hide the button)
VITE_PAYMENT_REVOLUT_URL=
VITE_PAYMENT_STRIPE_URL=
VITE_PAYMENT_PAYPAL_URL=

# Import script variables (do not expose service role key in frontend env)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
B2B_PRODUCTS_TABLE=b2b_products
GELITUP_PRODUCTS_API=https://gelitup.gr/wp-json/wc/store/v1/products
GELITUP_PRODUCTS_PER_PAGE=100
GELITUP_PRODUCTS_MAX_PAGES=20

# Zoho Books script credentials (for scripts/fetch-zoho-item-map.mjs)
# Use a static access token for a quick one-off run, or the refresh-token flow for longevity.
ZOHO_BOOKS_ORGANIZATION_ID=
ZOHO_BOOKS_ACCESS_TOKEN=
# — OR — all three for the refresh-token flow:
ZOHO_BOOKS_REFRESH_TOKEN=
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
# Optional overrides:
# ZOHO_BOOKS_BASE_URL=https://www.zohoapis.com/books/v3
# ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com

# ── Supabase Edge Function secrets (set via `supabase secrets set`) ────────────
# zoho-sync-order:
#   SUPABASE_URL                  (auto-injected in hosted Supabase projects)
#   SUPABASE_SERVICE_ROLE_KEY     (auto-injected in hosted Supabase projects)
#   ZOHO_BOOKS_ORGANIZATION_ID
#   ZOHO_BOOKS_ACCESS_TOKEN or ZOHO_BOOKS_REFRESH_TOKEN+CLIENT_ID+CLIENT_SECRET
#   ZOHO_BOOKS_ITEM_MAP_JSON      (output of scripts/fetch-zoho-item-map.mjs)
#   ZOHO_SYNC_SHARED_SECRET       (match VITE_ZOHO_SYNC_AUTH_TOKEN)
#
# zoho-webhook-receiver:
#   SUPABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY
#   ZOHO_WEBHOOK_SHARED_SECRET    (set in Zoho Books → Webhooks → custom header)
