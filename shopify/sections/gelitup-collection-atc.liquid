{% comment %}
  GEL.IT.UP — Quick-Add-to-Cart buttons for collection / listing pages.

  INSTALL:
  1. Copy this file to your Shopify theme /sections/gelitup-collection-atc.liquid
  2. Open /templates/collection.json and add to "sections" + "order":
       "gelitup-collection-atc": { "type": "gelitup-collection-atc", "settings": {} }
  3. Save — ATC buttons appear automatically on all collection product cards.
{% endcomment %}

<style>
  /* Wrapper injected as SIBLING after the product card link — never inside <a> */
  .giup-atc-wrap {
    padding: 0 12px 12px;
    /* Ensure it sits outside any anchor tag */
    display: block;
  }
  .giup-atc-btn {
    display: block;
    width: 100%;
    max-width: 180px;
    background: #D43790;
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background 0.15s;
    text-align: center;
    line-height: 1;
    box-sizing: border-box;
  }
  .giup-atc-btn:hover:not(:disabled) { background: #b02d7a; }
  .giup-atc-btn:disabled {
    background: rgba(0,0,0,0.12);
    color: rgba(0,0,0,0.4);
    cursor: default;
  }
</style>

<script>
(function () {

  /* ── Update cart count bubbles ── */
  function refreshCartCount() {
    fetch('/cart.js')
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        document.querySelectorAll(
          '[data-cart-count],.cart-count,.header__cart-count,.cart-item-count,.cart-bubble'
        ).forEach(function (el) { el.textContent = cart.item_count; });
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      });
  }

  /* ── AJAX Add to Cart ── */
  function addToCart(variantId, btn) {
    btn.disabled = true;
    btn.textContent = '...';
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      if (data.status && data.status >= 400) {
        btn.textContent = 'Errore';
        btn.style.background = '#dc2626';
      } else {
        btn.textContent = '✓ Aggiunto';
        btn.style.background = '#16a34a';
        refreshCartCount();
      }
      setTimeout(function () {
        btn.textContent = '+ Aggiungi';
        btn.style.background = '';
        btn.disabled = false;
      }, 2200);
    })
    .catch(function () {
      btn.textContent = 'Errore';
      btn.style.background = '#dc2626';
      setTimeout(function () {
        btn.textContent = '+ Aggiungi';
        btn.style.background = '';
        btn.disabled = false;
      }, 2200);
    });
  }

  /* ── Build one button (variant ID already known) ── */
  function buildButton(variantId, soldOut) {
    var btn = document.createElement('button');
    btn.className = 'giup-atc-btn';
    btn.type = 'button';
    if (soldOut || !variantId) {
      btn.textContent = 'Esaurito';
      btn.disabled = true;
    } else {
      btn.textContent = '+ Aggiungi';
      btn._variantId = variantId;
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        addToCart(btn._variantId, btn);
      });
    }
    return btn;
  }

  /* ── Inject buttons after fetching all variant IDs upfront ── */
  function injectAll() {
    /* Collect unique handles + their card containers */
    var cards = []; /* [{ handle, container }] */
    var seenHandles = new Set();

    document.querySelectorAll('a[href*="/products/"]').forEach(function (link) {
      if (link.closest('.giup-atc-wrap')) return;

      var href = link.getAttribute('href') || '';
      var m = href.match(/\/products\/([^?#/]+)/);
      if (!m) return;
      var handle = m[1];

      /* Deduplicate strictly by handle — prevents double injection from
         Whisper cards that have two <a> tags (image link + title link) */
      if (seenHandles.has(handle)) return;

      /* Only use li.grid__item — broad class* selectors match sub-elements */
      var container = link.closest('li.grid__item') ||
                      link.closest('li[class*="grid"]') ||
                      link.closest('.product-item');
      if (!container) return;

      seenHandles.add(handle);
      cards.push({ handle: handle, container: container });
    });

    if (cards.length === 0) return;

    /* Fetch all products in parallel, then inject */
    var promises = cards.map(function (item) {
      return fetch('/products/' + item.handle + '.js')
        .then(function (r) { return r.json(); })
        .then(function (product) {
          /* Skip if button already injected (e.g. after filter reload) */
          if (item.container.querySelector('.giup-atc-btn')) return;

          var avail = product.variants && product.variants.find(function (v) { return v.available; });
          var soldOut = !avail;

          var wrap = document.createElement('div');
          wrap.className = 'giup-atc-wrap';
          wrap.appendChild(buildButton(avail ? avail.id : null, soldOut));

          /* Append wrap as last child of the container (outside any <a>) */
          item.container.appendChild(wrap);
        })
        .catch(function () { /* silently skip on error */ });
    });
  }

  /* ── Run once on DOM ready ── */
  function ready(fn) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fn);
    } else {
      fn();
    }
  }

  ready(injectAll);

  /* ── Re-run after infinite scroll / filter updates (conservative) ── */
  var debounce;
  var observer = new MutationObserver(function (mutations) {
    /* Only react if new li.grid__item elements were added */
    var hasNewCards = mutations.some(function (m) {
      return Array.prototype.some.call(m.addedNodes, function (node) {
        return node.nodeType === 1 && (
          node.matches('li.grid__item, [class*="product-card"]') ||
          node.querySelector && node.querySelector('li.grid__item, [class*="product-card"]')
        );
      });
    });
    if (!hasNewCards) return;
    clearTimeout(debounce);
    debounce = setTimeout(injectAll, 400);
  });

  /* Only observe the product grid, not the whole body */
  ready(function () {
    var grid = document.querySelector('ul.grid, .product-grid, [class*="collection-grid"], main');
    if (grid) {
      observer.observe(grid, { childList: true, subtree: true });
    }
  });

})();
</script>

{% schema %}
{
  "name": "GEL.IT.UP ATC Inject",
  "settings": [],
  "presets": [
    {
      "name": "GEL.IT.UP ATC Inject"
    }
  ]
}
{% endschema %}
