{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-collection-grid-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-collection-grid-title-{{ ai_gen_id }} {
    font-size: {{ section.settings.heading_size }}px;
    color: {{ section.settings.heading_color }};
    margin: 0 0 16px;
  }

  .ai-collection-grid-description-{{ ai_gen_id }} {
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .ai-collection-grid-main-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    transition: opacity 0.3s ease;
  }

  .ai-collection-grid-main-{{ ai_gen_id }}.hidden {
    opacity: 0;
    pointer-events: none;
    height: 0;
    overflow: hidden;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-color: {{ section.settings.card_background }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
  }

  .ai-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-collection-card-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    overflow: hidden;
    position: relative;
  }

  .ai-collection-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card-image-{{ ai_gen_id }} img {
    transform: scale(1.05);
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-card-content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-collection-card-title-{{ ai_gen_id }} {
    font-size: {{ section.settings.card_title_size }}px;
    color: {{ section.settings.card_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-collection-card-count-{{ ai_gen_id }} {
    font-size: {{ section.settings.card_text_size }}px;
    color: {{ section.settings.card_text_color }};
    margin: 0;
  }

  .ai-collection-subcollections-{{ ai_gen_id }} {
    margin-top: 40px;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.4s ease, max-height 0.4s ease;
  }

  .ai-collection-subcollections-{{ ai_gen_id }}.active {
    opacity: 1;
    max-height: 5000px;
  }

  .ai-collection-subcollections-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .ai-collection-subcollections-footer-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-start;
    margin-top: 32px;
  }

  .ai-collection-subcollections-title-{{ ai_gen_id }} {
    font-size: {{ section.settings.subcollection_heading_size }}px;
    color: {{ section.settings.heading_color }};
    margin: 0;
  }

  .ai-collection-back-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: #D43790;
    color: #ffffff;
    border: 2px solid #D43790;
    border-radius: {{ section.settings.button_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
    font-weight: 500;
  }

  .ai-collection-back-button-{{ ai_gen_id }}:hover {
    background-color: #BF3182;
    color: #ffffff;
    border-color: #BF3182;
  }

  .ai-collection-back-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  .ai-collection-subcollections-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ section.settings.subcollection_columns_desktop }}, 1fr);
    gap: {{ section.settings.subcollection_grid_gap }}px;
  }

  .ai-collection-subcard-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ section.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-color: {{ section.settings.card_background }};
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
  }

  .ai-collection-subcard-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-collection-subcard-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  @media screen and (max-width: 989px) {
    .ai-collection-grid-main-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-collection-subcollections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-collection-grid-main-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-collection-subcollections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ section.settings.subcollection_columns_mobile }}, 1fr);
      gap: {{ section.settings.subcollection_grid_gap | times: 0.75 }}px;
    }

    .ai-collection-grid-title-{{ ai_gen_id }} {
      font-size: {{ section.settings.heading_size | times: 0.7 }}px;
    }

    .ai-collection-subcollections-title-{{ ai_gen_id }} {
      font-size: {{ section.settings.subcollection_heading_size | times: 0.7 }}px;
    }

    .ai-collection-card-content-{{ ai_gen_id }} {
      padding: 16px;
    }
  }
{% endstyle %}

<two-level-collection-grid-{{ ai_gen_id }}
  class="ai-collection-grid-{{ ai_gen_id }}"
  {{ section.shopify_attributes }}
>
  <div class="ai-collection-grid-container-{{ ai_gen_id }}">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="ai-collection-grid-header-{{ ai_gen_id }}">
        {% if section.settings.heading != blank %}
          <h2 class="ai-collection-grid-title-{{ ai_gen_id }}">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="ai-collection-grid-description-{{ ai_gen_id }}">{{ section.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-collection-grid-main-{{ ai_gen_id }}" data-main-grid>
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}
        {% assign subcollections = block.settings.subcollections %}
        {% if collection != blank %}
          <div
            class="ai-collection-card-{{ ai_gen_id }}"
            data-collection-index="{{ block.id }}"
            {{ block.shopify_attributes }}
            {% unless subcollections != blank %}onclick="window.location='{{ collection.url }}'"{% endunless %}
          >
            <div class="ai-collection-card-image-{{ ai_gen_id }}">
              {% if collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 800 }}"
                  alt="{{ collection.image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% elsif collection.products.first and collection.products.first.featured_image %}
                <img
                  src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.products.first.featured_image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-collection-card-content-{{ ai_gen_id }}">
              <h3 class="ai-collection-card-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              <p class="ai-collection-card-count-{{ ai_gen_id }}">
                {{ collection.products_count }}
                {% if collection.products_count == 1 %}product{% else %}products{% endif %}
              </p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% for block in section.blocks %}
      {% assign collection = block.settings.collection %}
      {% assign subcollections = block.settings.subcollections %}
      {% if collection != blank and subcollections != blank %}
        <div class="ai-collection-subcollections-{{ ai_gen_id }}" data-subcollections="{{ block.id }}">
          <div class="ai-collection-subcollections-header-{{ ai_gen_id }}">
            <h3 class="ai-collection-subcollections-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
            <button class="ai-collection-back-button-{{ ai_gen_id }}" data-back-button>
              <svg class="ai-collection-back-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              Back to collections
            </button>
          </div>
          <div class="ai-collection-subcollections-grid-{{ ai_gen_id }}">
            {% for subcollection in subcollections %}
              <div class="ai-collection-subcard-{{ ai_gen_id }}">
                <a href="{{ subcollection.url }}" class="ai-collection-subcard-link-{{ ai_gen_id }}">
                  <div class="ai-collection-card-image-{{ ai_gen_id }}">
                    {% if subcollection.image %}
                      <img
                        src="{{ subcollection.image | image_url: width: 600 }}"
                        alt="{{ subcollection.image.alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% elsif subcollection.products.first and subcollection.products.first.featured_image %}
                      <img
                        src="{{ subcollection.products.first.featured_image | image_url: width: 600 }}"
                        alt="{{ subcollection.products.first.featured_image.alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
                        {{ 'collection-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  <div class="ai-collection-card-content-{{ ai_gen_id }}">
                    <h4 class="ai-collection-card-title-{{ ai_gen_id }}">{{ subcollection.title }}</h4>
                    <p class="ai-collection-card-count-{{ ai_gen_id }}">
                      {{ subcollection.products_count }}
                      {% if subcollection.products_count == 1 %}
                        product
                      {% else %}
                        products
                      {% endif %}
                    </p>
                  </div>
                </a>
              </div>
            {% endfor %}
          </div>
          <div class="ai-collection-subcollections-footer-{{ ai_gen_id }}">
            <button class="ai-collection-back-button-{{ ai_gen_id }}" data-back-button>
              <svg class="ai-collection-back-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              Back to collections
            </button>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</two-level-collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoLevelCollectionGridS{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.mainGrid = this.querySelector('[data-main-grid]');
        this.collectionCards = this.querySelectorAll('[data-collection-index]');
        this.subcollectionSections = this.querySelectorAll('[data-subcollections]');
        this.backButtons = this.querySelectorAll('[data-back-button]');
        this.activeSubcollection = null;
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.collectionCards.forEach((card) => {
          card.addEventListener('click', () => {
            const index = card.getAttribute('data-collection-index');
            this.showSubcollections(index);
          });
        });

        this.backButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.stopPropagation();
            this.hideSubcollections();
          });
        });
      }

      showSubcollections(index) {
        const subcollectionSection = this.querySelector(`[data-subcollections="${index}"]`);

        if (!subcollectionSection) {
          return;
        }

        this.mainGrid.classList.add('hidden');

        this.subcollectionSections.forEach((section) => {
          section.classList.remove('active');
        });

        setTimeout(() => {
          subcollectionSection.classList.add('active');
          this.activeSubcollection = subcollectionSection;

          subcollectionSection.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }, 100);
      }

      hideSubcollections() {
        if (this.activeSubcollection) {
          this.activeSubcollection.classList.remove('active');
          this.activeSubcollection = null;
        }

        setTimeout(() => {
          this.mainGrid.classList.remove('hidden');

          this.mainGrid.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }, 100);
      }
    }

    customElements.define('two-level-collection-grid-{{ ai_gen_id }}', TwoLevelCollectionGridS{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Two-level collection grid",
  "blocks": [
    {
      "type": "collection_entry",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
