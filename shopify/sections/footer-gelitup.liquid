{% comment %}
  GEL.IT.UP Italy — Custom footer section
  4-column layout: Brand | Contact | Menu | Connect
{% endcomment %}

<style>
  /* Ensure section wrapper stretches full-width inside Whisper theme's flex body */
  .giup-footer-section {
    width: 100%;
    align-self: stretch;
  }

  .giup-footer {
    width: 100%;
    background-color: #1a1a1a;
    color: #ffffff;
    font-family: 'Montserrat', sans-serif;
    padding: 60px 0 0;
  }

  .giup-footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: grid;
    grid-template-columns: 2fr 1.5fr 1.5fr 1.5fr;
    gap: 48px;
  }

  .giup-footer__col-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #D43790;
    margin: 0 0 20px;
  }

  /* Column 1 — Brand */
  .giup-footer__logo {
    display: block;
    margin-bottom: 20px;
  }

  .giup-footer__logo img {
    height: 48px;
    width: auto;
  }

  .giup-footer__brand-name {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 6px;
  }

  .giup-footer__brand-tagline {
    font-size: 12px;
    color: #aaaaaa;
    line-height: 1.5;
    margin: 0 0 24px;
  }

  /* Newsletter */
  .giup-footer__newsletter-form {
    display: flex;
    gap: 0;
    margin-top: 16px;
  }

  .giup-footer__newsletter-input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid #444;
    border-right: none;
    background: #2a2a2a;
    color: #ffffff;
    font-size: 13px;
    border-radius: 4px 0 0 4px;
    outline: none;
  }

  .giup-footer__newsletter-input::placeholder {
    color: #888;
  }

  .giup-footer__newsletter-btn {
    padding: 10px 18px;
    background: #D43790;
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    border-radius: 0 4px 4px 0;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .giup-footer__newsletter-btn:hover {
    background: #BF3182;
  }

  /* Column 2 — Contact */
  .giup-footer__contact-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .giup-footer__contact-list li {
    font-size: 13px;
    color: #cccccc;
    line-height: 1.4;
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .giup-footer__contact-list li svg {
    flex-shrink: 0;
    margin-top: 2px;
    fill: #D43790;
  }

  .giup-footer__contact-list a {
    color: #cccccc;
    text-decoration: none;
    transition: color 0.2s;
  }

  .giup-footer__contact-list a:hover {
    color: #D43790;
  }

  /* Column 3 — Menu */
  .giup-footer__nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .giup-footer__nav-list a {
    font-size: 13px;
    color: #cccccc;
    text-decoration: none;
    transition: color 0.2s;
  }

  .giup-footer__nav-list a:hover {
    color: #D43790;
  }

  /* Column 4 — Connect */
  .giup-footer__social-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .giup-footer__social-link {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
    color: #cccccc;
    text-decoration: none;
    transition: color 0.2s;
  }

  .giup-footer__social-link:hover {
    color: #D43790;
  }

  .giup-footer__social-link svg {
    flex-shrink: 0;
    fill: currentColor;
  }

  /* Bottom bar */
  .giup-footer__bottom {
    margin-top: 48px;
    border-top: 1px solid #333;
    padding: 20px 24px;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .giup-footer__copyright {
    font-size: 12px;
    color: #888888;
  }

  .giup-footer__bottom-icons {
    display: flex;
    gap: 16px;
  }

  .giup-footer__bottom-icons a {
    color: #888888;
    transition: color 0.2s;
    display: flex;
    align-items: center;
  }

  .giup-footer__bottom-icons a:hover {
    color: #D43790;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .giup-footer__inner {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 600px) {
    .giup-footer__inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .giup-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<div class="giup-footer">
