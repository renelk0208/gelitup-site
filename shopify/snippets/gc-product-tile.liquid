{%- comment -%}
  GEL.IT.UP Product Tile Snippet
  Usage: {%- render 'gc-product-tile', product: product -%}
  Install: copy to /snippets/gc-product-tile.liquid
{%- endcomment -%}

{%- liquid
  assign tile_img   = product.featured_image | image_url: width: 300
  assign tile_sku   = product.variants.first.sku | default: ''
  assign tile_price = product.price_min | money
  assign tile_avail = product.available
  assign tile_vid   = product.variants.first.id
-%}

<article class="gc-tile">
  {%- unless tile_avail -%}
    <span class="gc-tile__badge gc-tile__badge--sold-out">Sold Out</span>
  {%- endunless -%}

  <a href="{{ product.url }}" style="display:contents;">
    <div class="gc-tile__img-wrap">
      {%- if product.featured_image -%}
        <img
          src="{{ tile_img }}"
          alt="{{ product.title | escape }}"
          loading="lazy"
          width="300"
          height="300"
        />
      {%- else -%}
        <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#2a2a2a;">
          <span style="color:rgba(255,255,255,0.15);font-size:11px;">No image</span>
        </div>
      {%- endif -%}
    </div>
  </a>

  <div class="gc-tile__body">
    <a href="{{ product.url }}" style="text-decoration:none;color:inherit;">
      <p class="gc-tile__name">{{ product.title }}</p>
    </a>
    {%- if tile_sku != blank -%}
      <p class="gc-tile__code">{{ tile_sku }}</p>
    {%- endif -%}

    {%- if tile_avail -%}
      <p class="gc-tile__price">{{ tile_price }}</p>
      <button
        class="gc-tile__atc"
        data-vid="{{ tile_vid }}"
        onclick="gcAddToCart({{ tile_vid }}, this)"
        type="button"
      >+ Add</button>
    {%- else -%}
      <p class="gc-tile__sold-out">Sold Out</p>
      <button class="gc-tile__atc" disabled type="button">Sold Out</button>
    {%- endif -%}
  </div>
</article>
