{% comment %}
  GEL.IT.UP Breadcrumbs snippet
  Add once to theme.liquid just before {% section 'header' %} or just after it:
    {%- unless template.name == 'index' -%}
      {%- render 'breadcrumbs' -%}
    {%- endunless -%}
  Covers: collection, product, page, blog, article, search, cart, 404.
{% endcomment %}

{%- liquid
  assign catalogue_url   = '/pages/catalogue'
  assign catalogue_label = 'Shop the Collection'
  assign show_breadcrumbs = true
  if template.name == 'index'
    assign show_breadcrumbs = false
  endif
-%}

{%- if show_breadcrumbs -%}
<nav class="gc-breadcrumbs" aria-label="Breadcrumb">
  <style>
    .gc-breadcrumbs {
      padding: 10px 20px;
      font-size: 12px;
      background: transparent;
    }
    .gc-breadcrumbs__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0;
    }
    .gc-breadcrumbs__item {
      display: flex;
      align-items: center;
    }
    .gc-breadcrumbs__link {
      color: #888;
      text-decoration: none;
      transition: color 0.2s;
    }
    .gc-breadcrumbs__link:hover {
      color: #D43790;
      text-decoration: underline;
    }
    .gc-breadcrumbs__current {
      color: #333;
      font-weight: 500;
      max-width: 260px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .gc-breadcrumbs__sep {
      color: #ccc;
      margin: 0 6px;
      user-select: none;
    }
    @media (max-width: 749px) {
      .gc-breadcrumbs { padding: 8px 16px; font-size: 11px; }
      .gc-breadcrumbs__current { max-width: 160px; }
    }
  </style>

  <ol class="gc-breadcrumbs__list" itemscope itemtype="https://schema.org/BreadcrumbList">

    {%- comment -%} Home {%- endcomment -%}
    <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
      <a href="{{ shop.url }}" class="gc-breadcrumbs__link" itemprop="item"><span itemprop="name">Home</span></a>
      <meta itemprop="position" content="1">
      <span class="gc-breadcrumbs__sep" aria-hidden="true">/</span>
    </li>

    {%- if template.name == 'collection' -%}

      <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{ catalogue_url }}" class="gc-breadcrumbs__link" itemprop="item"><span itemprop="name">{{ catalogue_label }}</span></a>
        <meta itemprop="position" content="2">
        <span class="gc-breadcrumbs__sep" aria-hidden="true">/</span>
      </li>
      <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="gc-breadcrumbs__current" itemprop="name" aria-current="page">{{ collection.title }}</span>
        <meta itemprop="position" content="3">
      </li>

    {%- elsif template.name == 'product' -%}

      <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{ catalogue_url }}" class="gc-breadcrumbs__link" itemprop="item"><span itemprop="name">{{ catalogue_label }}</span></a>
        <meta itemprop="position" content="2">
        <span class="gc-breadcrumbs__sep" aria-hidden="true">/</span>
      </li>
      {%- liquid
        assign bc_collection = collection
        if bc_collection == nil
          for c in product.collections
            if c.handle != 'all' and c.handle != 'frontpage'
              assign bc_collection = c
              break
            endif
          endfor
        endif
      -%}
      {%- if bc_collection -%}
        <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <a href="{{ bc_collection.url }}" class="gc-breadcrumbs__link" itemprop="item"><span itemprop="name">{{ bc_collection.title }}</span></a>
          <meta itemprop="position" content="3">
          <span class="gc-breadcrumbs__sep" aria-hidden="true">/</span>
        </li>
        <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="gc-breadcrumbs__current" itemprop="name" aria-current="page">{{ product.title }}</span>
          <meta itemprop="position" content="4">
        </li>
      {%- else -%}
        <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <span class="gc-breadcrumbs__current" itemprop="name" aria-current="page">{{ product.title }}</span>
          <meta itemprop="position" content="3">
        </li>
      {%- endif -%}

    {%- elsif template.name == 'article' -%}

      <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="{{ blog.url }}" class="gc-breadcrumbs__link" itemprop="item"><span itemprop="name">{{ blog.title }}</span></a>
        <meta itemprop="position" content="2">
        <span class="gc-breadcrumbs__sep" aria-hidden="true">/</span>
      </li>
      <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="gc-breadcrumbs__current" itemprop="name" aria-current="page">{{ article.title }}</span>
        <meta itemprop="position" content="3">
      </li>

    {%- elsif template.name == 'blog' -%}

      <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="gc-breadcrumbs__current" itemprop="name" aria-current="page">{{ blog.title }}</span>
        <meta itemprop="position" content="2">
      </li>

    {%- elsif template.name == 'page' -%}

      <li class="gc-breadcrumbs__item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <span class="gc-breadcrumbs__current" itemprop="name" aria-current="page">{{ page.title }}</span>
        <meta itemprop="position" content="2">
      </li>

    {%- elsif template.name == 'search' -%}

      <li class="gc-breadcrumbs__item">
        <span class="gc-breadcrumbs__current" aria-current="page">Search results{% if search.performed %}: {{ search.terms | escape }}{% endif %}</span>
      </li>

    {%- elsif template.name == 'cart' -%}

      <li class="gc-breadcrumbs__item">
        <span class="gc-breadcrumbs__current" aria-current="page">Cart</span>
      </li>

    {%- elsif template.name == '404' -%}

      <li class="gc-breadcrumbs__item">
        <span class="gc-breadcrumbs__current" aria-current="page">Page not found</span>
      </li>

    {%- endif -%}

  </ol>
</nav>
{%- endif -%}