{% doc %}
  @prompt
    Create a two-level collection block for the collections page. It should display top-level collection cards. When a top-level collection card is clicked, the page smoothly reveals a grid of subcollection cards beneath it (without navigating away from the page). Each top-level collection should have a configurable list of subcollections linked to it. The design should match the store's existing theme style, be fully mobile responsive, and include a back/close button to collapse the subcollections and return to the top-level grid view.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 0 20px;
  }

  .ai-collection-grid-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-collection-grid-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-collection-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
  }

  .ai-collection-grid-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-collection-grid-main-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    transition: opacity 0.3s ease;
  }

  .ai-collection-grid-main-{{ ai_gen_id }}.hidden {
    opacity: 0;
    pointer-events: none;
    height: 0;
    overflow: hidden;
  }

  .ai-collection-card-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-collection-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-collection-card-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    position: relative;
  }

  .ai-collection-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-collection-card-{{ ai_gen_id }}:hover .ai-collection-card-image-{{ ai_gen_id }} img {
    transform: scale(1.05);
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-collection-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-collection-card-content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-collection-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 8px;
    font-weight: 600;
  }

  .ai-collection-card-count-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0;
  }

  .ai-collection-subcollections-{{ ai_gen_id }} {
    margin-top: 0;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.4s ease, max-height 0.4s ease;
  }

  .ai-collection-subcollections-{{ ai_gen_id }}.active {
    opacity: 1;
    max-height: 5000px;
    margin-top: 40px;
  }

  .ai-collection-subcollections-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .ai-collection-subcollections-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.subcollection_heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-collection-back-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
    font-weight: 500;
  }

  .ai-collection-back-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-collection-back-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  .ai-collection-subcollections-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.subcollection_columns_desktop }}, 1fr);
    gap: {{ block.settings.subcollection_grid_gap }}px;
  }

  .ai-collection-subcard-{{ ai_gen_id }} {
    position: relative;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
  }

  .ai-collection-subcard-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-collection-subcard-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
    cursor: pointer;
  }

  /* ── Product panels (level 3) ── */
  .ai-products-panel-{{ ai_gen_id }} {
    margin-top: 0;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: opacity 0.4s ease, max-height 0.4s ease;
  }

  .ai-products-panel-{{ ai_gen_id }}.active {
    opacity: 1;
    max-height: 10000px;
    margin-top: 40px;
  }

  .ai-products-panel-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .ai-products-panel-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.subcollection_heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.subcollection_columns_desktop }}, 1fr);
    gap: {{ block.settings.subcollection_grid_gap }}px;
  }

  .ai-product-card-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
    display: block;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-product-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-card-image-{{ ai_gen_id }} img {
    transform: scale(1.05);
  }

  .ai-product-card-content-{{ ai_gen_id }} {
    padding: 16px;
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_size }}px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 6px;
    font-weight: 600;
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_text_size }}px;
    color: {{ block.settings.card_text_color }};
    margin: 0;
  }

  .ai-products-panel-footer-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-start;
    margin-top: 32px;
  }

  @media screen and (max-width: 989px) {
    .ai-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.subcollection_columns_mobile }}, 1fr);
      gap: {{ block.settings.subcollection_grid_gap | times: 0.75 }}px;
    }
  }

  @media screen and (max-width: 989px) {
    .ai-collection-grid-main-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-collection-subcollections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-collection-grid-{{ ai_gen_id }} {
      padding: 0 16px;
    }

    .ai-collection-grid-main-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-collection-subcollections-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.subcollection_columns_mobile }}, 1fr);
      gap: {{ block.settings.subcollection_grid_gap | times: 0.75 }}px;
    }

    .ai-collection-grid-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-collection-subcollections-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.subcollection_heading_size | times: 0.7 }}px;
    }

    .ai-collection-card-content-{{ ai_gen_id }} {
      padding: 16px;
    }
  }
{% endstyle %}

<two-level-collection-grid-{{ ai_gen_id }}
  class="ai-collection-grid-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-collection-grid-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.description != blank %}
      <div class="ai-collection-grid-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-collection-grid-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <div class="ai-collection-grid-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-collection-grid-main-{{ ai_gen_id }}" data-main-grid>
      {% for i in (1..15) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign subcollections_key = 'subcollections_' | append: i
          assign collection = block.settings[collection_key]
          assign subcollections = block.settings[subcollections_key]
        %}

        {% if collection != blank %}
          <div class="ai-collection-card-{{ ai_gen_id }}" data-collection-index="{{ i }}"{% unless subcollections != blank %} onclick="window.location='{{ collection.url }}'"{% endunless %}>
            <div class="ai-collection-card-image-{{ ai_gen_id }}">
              {% if collection.image %}
                <img
                  src="{{ collection.image | image_url: width: 800 }}"
                  alt="{{ collection.image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% elsif collection.products.first and collection.products.first.featured_image %}
                <img
                  src="{{ collection.products.first.featured_image | image_url: width: 800 }}"
                  alt="{{ collection.products.first.featured_image.alt | escape }}"
                  loading="lazy"
                  width="800"
                  height="800"
                >
              {% else %}
                <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-collection-card-content-{{ ai_gen_id }}">
              <h3 class="ai-collection-card-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
              <p class="ai-collection-card-count-{{ ai_gen_id }}">
                {{ collection.products_count }}
                {% if collection.products_count == 1 %}
                  product
                {% else %}
                  products
                {% endif %}
              </p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% for i in (1..15) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign subcollections_key = 'subcollections_' | append: i
        assign collection = block.settings[collection_key]
        assign subcollections = block.settings[subcollections_key]
      %}

      {% if collection != blank and subcollections != blank %}
        <div class="ai-collection-subcollections-{{ ai_gen_id }}" data-subcollections="{{ i }}">
          <div class="ai-collection-subcollections-header-{{ ai_gen_id }}">
            <h3 class="ai-collection-subcollections-title-{{ ai_gen_id }}">{{ collection.title }}</h3>
            <button class="ai-collection-back-button-{{ ai_gen_id }}" data-back-button>
              <svg class="ai-collection-back-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              Back to collections
            </button>
          </div>
          <div class="ai-collection-subcollections-grid-{{ ai_gen_id }}">
            {% for subcollection in subcollections %}
              <div class="ai-collection-subcard-{{ ai_gen_id }}" data-show-products="{{ i }}-{{ forloop.index }}">
                <div class="ai-collection-subcard-link-{{ ai_gen_id }}">
                  <div class="ai-collection-card-image-{{ ai_gen_id }}">
                    {% if subcollection.image %}
                      <img
                        src="{{ subcollection.image | image_url: width: 600 }}"
                        alt="{{ subcollection.image.alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% elsif subcollection.products.first and subcollection.products.first.featured_image %}
                      <img
                        src="{{ subcollection.products.first.featured_image | image_url: width: 600 }}"
                        alt="{{ subcollection.products.first.featured_image.alt | escape }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
                        {{ 'collection-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  <div class="ai-collection-card-content-{{ ai_gen_id }}">
                    <h4 class="ai-collection-card-title-{{ ai_gen_id }}">{{ subcollection.title }}</h4>
                    <p class="ai-collection-card-count-{{ ai_gen_id }}">
                      {{ subcollection.products_count }}
                      {% if subcollection.products_count == 1 %}
                        product
                      {% else %}
                        products
                      {% endif %}
                    </p>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% comment %} Level 3: Product panels (one per subcollection) {% endcomment %}
    {% for i in (1..15) %}
      {% liquid
        assign collection_key = 'collection_' | append: i
        assign subcollections_key = 'subcollections_' | append: i
        assign collection = block.settings[collection_key]
        assign subcollections = block.settings[subcollections_key]
      %}
      {% if collection != blank and subcollections != blank %}
        {% for subcollection in subcollections %}
          <div class="ai-products-panel-{{ ai_gen_id }}" data-products="{{ i }}-{{ forloop.index }}">
            <div class="ai-products-panel-header-{{ ai_gen_id }}">
              <h3 class="ai-products-panel-title-{{ ai_gen_id }}">{{ subcollection.title }}</h3>
              <button class="ai-collection-back-button-{{ ai_gen_id }}" data-back-to-sub="{{ i }}">
                <svg class="ai-collection-back-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="19" y1="12" x2="5" y2="12"></line>
                  <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Back to {{ collection.title }}
              </button>
            </div>
            <div class="ai-products-grid-{{ ai_gen_id }}">
              {% for product in subcollection.products limit: 48 %}
                <a href="{{ product.url }}" class="ai-product-card-{{ ai_gen_id }}">
                  <div class="ai-product-card-image-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 400 }}"
                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                        loading="lazy"
                        width="400"
                        height="400"
                      >
                    {% else %}
                      <div class="ai-collection-card-placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                  <div class="ai-product-card-content-{{ ai_gen_id }}">
                    <h4 class="ai-product-card-title-{{ ai_gen_id }}">{{ product.title }}</h4>
                    <p class="ai-product-card-price-{{ ai_gen_id }}">{{ product.price_min | money }}</p>
                  </div>
                </a>
              {% endfor %}
            </div>
            <div class="ai-products-panel-footer-{{ ai_gen_id }}">
              <button class="ai-collection-back-button-{{ ai_gen_id }}" data-back-to-sub="{{ i }}">
                <svg class="ai-collection-back-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="19" y1="12" x2="5" y2="12"></line>
                  <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Back to {{ collection.title }}
              </button>
            </div>
          </div>
        {% endfor %}
      {% endif %}
    {% endfor %}

  </div>
</two-level-collection-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoLevelCollectionGridB{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.mainGrid = this.querySelector('[data-main-grid]');
        this.collectionCards = this.querySelectorAll('[data-collection-index]');
        this.subcollectionSections = this.querySelectorAll('[data-subcollections]');
        this.subcollectionCards = this.querySelectorAll('[data-show-products]');
        this.productsPanels = this.querySelectorAll('[data-products]');
        this.backButtons = this.querySelectorAll('[data-back-button]');
        this.backToSubButtons = this.querySelectorAll('[data-back-to-sub]');
        this.activeSubcollection = null;
        this.activeProductsPanel = null;
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.collectionCards.forEach((card) => {
          card.addEventListener('click', () => {
            const index = card.getAttribute('data-collection-index');
            this.showSubcollections(index);
          });
        });

        this.subcollectionCards.forEach((card) => {
          card.addEventListener('click', () => {
            const key = card.getAttribute('data-show-products');
            this.showProducts(key);
          });
        });

        this.backButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.stopPropagation();
            this.hideSubcollections();
          });
        });

        this.backToSubButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.stopPropagation();
            const collectionIndex = button.getAttribute('data-back-to-sub');
            this.hideProducts(collectionIndex);
          });
        });
      }

      showSubcollections(index) {
        const subcollectionSection = this.querySelector(`[data-subcollections="${index}"]`);

        if (!subcollectionSection) {
          return;
        }

        this.mainGrid.classList.add('hidden');

        this.subcollectionSections.forEach((sec) => {
          sec.classList.remove('active');
        });

        setTimeout(() => {
          subcollectionSection.classList.add('active');
          this.activeSubcollection = subcollectionSection;

          subcollectionSection.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }, 100);
      }

      hideSubcollections() {
        if (this.activeSubcollection) {
          this.activeSubcollection.classList.remove('active');
          this.activeSubcollection = null;
        }

        if (this.activeProductsPanel) {
          this.activeProductsPanel.classList.remove('active');
          this.activeProductsPanel = null;
        }

        setTimeout(() => {
          this.mainGrid.classList.remove('hidden');

          this.mainGrid.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }, 100);
      }

      showProducts(key) {
        const panel = this.querySelector(`[data-products="${key}"]`);
        if (!panel) return;

        if (this.activeSubcollection) {
          this.activeSubcollection.classList.remove('active');
        }

        this.productsPanels.forEach((p) => p.classList.remove('active'));

        setTimeout(() => {
          panel.classList.add('active');
          this.activeProductsPanel = panel;
          panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }, 100);
      }

      hideProducts(collectionIndex) {
        if (this.activeProductsPanel) {
          this.activeProductsPanel.classList.remove('active');
          this.activeProductsPanel = null;
        }

        const subPanel = this.querySelector(`[data-subcollections="${collectionIndex}"]`);
        if (subPanel) {
          setTimeout(() => {
            subPanel.classList.add('active');
            this.activeSubcollection = subPanel;
            subPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }, 100);
        }
      }
    }

    customElements.define('two-level-collection-grid-{{ ai_gen_id }}', TwoLevelCollectionGridB{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Two-level collection grid",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "label": "Description",
      "default": "Explore our curated collections"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Description size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "subcollection_heading_size",
      "label": "Subcollection heading size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Top-level collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1"
    },
    {
      "type": "collection_list",
      "id": "subcollections_1",
