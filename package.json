{
  "name": "gelitup-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-meta-product-feed.mjs && node scripts/generate-sitemap.mjs && node scripts/prerender.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:gelitup-products": "node scripts/sync-gelitup-products.mjs",
    "generate:product-image-map": "node scripts/generate-product-image-map.mjs",
    "sync:product-images-local": "node scripts/sync-product-images-from-local.mjs",
    "normalize:product-image-map": "node scripts/normalize-product-image-map.mjs",
    "import:product-images": "node scripts/import-product-images-from-map.mjs",
    "remap:product-image-skus": "node scripts/remap-image-skus-from-csv.mjs",
    "import:gelitup-media": "node scripts/import-gelitup-media.mjs",
    "snapshot:gelitup-pages": "node scripts/snapshot-gelitup-pages.mjs",
    "generate:imported-pages": "node scripts/generate-imported-pages.mjs",
    "generate:news-json": "node scripts/generate-news-json.mjs",
    "refresh:gelitup-baseline": "npm run import:gelitup-media; npm run snapshot:gelitup-pages; npm run generate:imported-pages",
    "replay:zoho-order": "node scripts/replay-order-to-zoho.mjs",
    "smoke:local": "node scripts/predeploy-smoke.mjs http://localhost:5173",
    "smoke:prod": "node scripts/predeploy-smoke.mjs https://gelitup.com",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "smoke:e2e:prod": "cross-env SMOKE_BASE_URL=https://gelitup.com node scripts/smoke-e2e.mjs",
    "audit:prices": "node scripts/audit-prices.mjs",
    "guardrails:catalogue": "node scripts/check-catalogue-invariants.mjs",
    "import:price-list": "node scripts/import-price-list.mjs",
    "generate:order-template": "node scripts/generate-client-order-template.mjs",
    "convert:order-to-zoho": "node scripts/convert-order-to-zoho-csv.mjs",
    "export:product-info-excel": "node scripts/export-product-info-excel.mjs",
    "import:product-info-excel": "node scripts/import-product-info-excel.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "nodemailer": "^8.0.7",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@prerenderer/renderer-jsdom": "^1.1.9",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.23",
    "exceljs": "^4.4.0",
    "globals": "^16.4.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "vite": "^7.1.9",
    "vite-plugin-prerender": "^1.0.8",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-core": "^7.3.0",
    "workbox-window": "^7.4.0",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "sharp": "^0.33.5",
    "sharp-ico": "^0.1.5"
  }
}
